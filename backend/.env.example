# Copy the variable names into your shell, IDE run configuration, container runtime,
# or secret manager. Do not commit real credentials.

DB_URL=jdbc:mysql://127.0.0.1:3306/cpt202_project_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
DB_USER=root
DB_PASSWORD=

# Generate a long random value for production/deployment use.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_SSL=true

# Optional one-time administrator creation. Disabled by default.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
